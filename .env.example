# ==============================================================
# Harness-Lite 三模型分层配置
# - 主模型 (MAIN)  必填：用于核心推理、安全审查、记忆蒸馏等全部场景
# - 中模型 (MEDIUM) 可选：未完整配置时自动降级到主模型
# - 小模型 (SMALL)  可选：未完整配置时自动降级到主模型
# thinking_mode 三组各自可配；中/小未显式设置 THINKING_MODE 时继承主模型
# ==============================================================

# ---- 主模型（必填，当前使用 NVIDIA 接入 deepseek-v4-pro） ----
LLM_MAIN_API_KEY=
LLM_MAIN_BASE_URL=
LLM_MAIN_MODEL_NAME=
LLM_MAIN_THINKING_MODE=
# 可选：显式覆盖主模型上下文窗口大小（token 数），不设则自动从模型名推导
LLM_MAIN_MAX_TOKENS=

# ---- 中模型（可选，留空则降级到主模型） ----
LLM_MEDIUM_API_KEY=
LLM_MEDIUM_BASE_URL=
LLM_MEDIUM_MODEL_NAME=
LLM_MEDIUM_THINKING_MODE=
# 可选：显式覆盖中模型上下文窗口大小（token 数），不设则自动从模型名推导
LLM_MEDIUM_MAX_TOKENS=

# ---- 小模型（可选，留空则降级到主模型） ----
LLM_SMALL_API_KEY=
LLM_SMALL_BASE_URL=
LLM_SMALL_MODEL_NAME=
LLM_SMALL_THINKING_MODE=
# 可选：显式覆盖小模型上下文窗口大小（token 数），不设则自动从模型名推导
LLM_SMALL_MAX_TOKENS=

# ---- 沙箱根目录（多路径用逗号分隔） ----
WORKSPACE_ROOT=harness_study/Harness-Lite/sandbox
